{"type":"message-part","messageId":"ef05b236-6f0e-4174-99c2-e32be31a7c27","role":"assistant","index":3,"part":{"type":"tool-writeToFile","toolCallId":"mH1Vj6bEQSYyUT0j","state":"input-streaming","input":{"path":"/home/user/multi-account-task/multi_slack.py","content":"import os\nfrom openai import OpenAI\nfrom composio import Composio, OpenAIProvider\n\ndef main():\n    # 1. Initialize `Composio` with `OpenAIProvider`.\n    composio = Composio(provider=OpenAIProvider())\n\n    # 2. Create a session for `zealt-user01` with `multi_account={'enable': True}`.\n    session = composio.create_session(\n        user_id='zealt-user01', \n        multi_account={'enable': True}\n    )\n\n    # 3. Use `session.authorize('slack', alias='work-slack')` and `session.authorize('slack', alias='personal-slack')`\n    session.authorize('slack', alias='work-slack')\n    session.authorize('slack', alias='personal-slack')\n\n    # 4. Initialize an OpenAI agent with the session tools.\n    client = OpenAI()\n    tools = session.get_tools()\n\n    # 5. Prompt the agent\n    prompt = \"Send 'Hello from Work!' to #general using the 'work-slack' account, and 'Hello from Personal!' to #general using the 'personal-slack' account.\"\n    \n    response = client.chat.completions.create(\n        model=\"gpt-4o\",\n        messages=[{\"role\": \"user\", \"content\": prompt}],\n        tools=tools,\n        tool_choice=\"auto\"\n    )\n\n    print(\"Agent responded:\")\n    print(response.choices[0].message)\n\nif __name__ == \"__main__\":\n    main()\n"}}}
